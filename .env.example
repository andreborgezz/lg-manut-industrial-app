# Postgres
POSTGRES_USER=lg-manutencao
POSTGRES_PASSWORD=troque_isso
POSTGRES_DB=lg_manut_db

# URL do frontend na Vercel (sem barra no final)
FRONT_URL=https://seu-projeto.vercel.app

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque_por_string_aleatoria_de_32_caracteres

# Cloudflare R2 (opcional — para armazenar PDFs)
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 Backup (opcional)
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# Resend (opcional — para envio de e-mail)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Healthcheck do backup (opcional)
BACKUP_PING_URL=
