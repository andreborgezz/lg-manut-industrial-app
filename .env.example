# Variáveis do docker-compose.prod.yml
# Copie para .env e preencha antes de subir

# Postgres
POSTGRES_USER=lg-manutencao
POSTGRES_PASSWORD=troque_isso
POSTGRES_DB=lg_manut_db

# Domínio público (Caddy pedirá o certificado Let's Encrypt automaticamente)
DOMAIN=seu-dominio.com

# E-mail para notificações do Let's Encrypt
ACME_EMAIL=seu@email.com
