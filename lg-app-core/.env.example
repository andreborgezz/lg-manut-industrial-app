# Servidor
PORT=3000
NODE_ENV=development

# PostgreSQL
# Nota: porta 5433 mapeada no docker-compose para não conflitar com Postgres local na 5432
DATABASE_URL=

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Mínimo 32 caracteres, nunca versione o valor real
JWT_SECRET=

# Cloudflare R2 (S3 Compatible Storage)
# Endpoint base: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_REGION=auto

R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Origem do front liberada no CORS
FRONT_URL=http://localhost:5173

# Resend Email
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
